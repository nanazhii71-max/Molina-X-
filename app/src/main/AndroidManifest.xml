<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Wajib eksplisit (blueprint Phase 3 item 6) — jangan andalkan warisan transitif dari dependency -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Wajib eksplisit (blueprint Phase 3 item 6) — TerminalService (Phase 3 item 5) butuh ini untuk startForeground(). Baseline API 26: normal permission, tanpa FOREGROUND_SERVICE_TYPE_* (itu baru wajib untuk targetSdk 34+, di luar scope proyek ini). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Wajib untuk PowerManager.PARTIAL_WAKE_LOCK & WifiManager.WifiLock (opt-in toggle
         via notifikasi TerminalService, meniru persis ACTION_WAKE_LOCK/ACTION_WAKE_UNLOCK
         resmi termux-app v0.118.3, TermuxService.java) — normal permission, tanpa prompt runtime. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />


    <application
        android:name=".MolinaXApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.MolinaX">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 3 item 5 (Bound Service, Opsi A — pola resmi TermuxService): in-process
             LocalBinder saja, tidak ada kebutuhan IPC lintas app, jadi exported="false".
             android:foregroundServiceType TIDAK dideklarasikan — atribut ini baru wajib untuk
             targetSdk 29+/34+ (di luar scope: targetSdk proyek dikunci 26, lihat root
             build.gradle.kts molinaxTargetSdk), jangan tambahkan tanpa kebutuhan nyata. -->
        <service
            android:name="com.molinax.terminal.service.TerminalService"
            android:exported="false" />

    </application>

</manifest>
