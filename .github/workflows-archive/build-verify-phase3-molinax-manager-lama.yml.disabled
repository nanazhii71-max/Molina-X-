name: Build Verify

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]
  workflow_dispatch:

jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v7

      - name: Setup JDK 21 (Temurin)
        uses: actions/setup-java@v6
        with:
          distribution: temurin
          java-version: '21'
          cache: gradle

      - name: Accept SDK licenses
        run: |
          yes | "${ANDROID_SDK_ROOT}/cmdline-tools/latest/bin/sdkmanager" --licenses > /dev/null

      # Sesuai AGP 9.1.1 (mendukung resmi hingga API level 37.0):
      # platform QPR baseline 37.0, bukan 37.1/37.2 yang belum diuji dengan AGP 9.1.1.
      - name: Install NDK 28.2.13676358, Build-Tools 37.0.0, Platform 37.0
        run: |
          "${ANDROID_SDK_ROOT}/cmdline-tools/latest/bin/sdkmanager" \
            "ndk;28.2.13676358" \
            "build-tools;37.0.0" \
            "platforms;android-37.0"

      - name: VERIFY packages actually installed on disk
        run: |
          test -d "${ANDROID_SDK_ROOT}/ndk/28.2.13676358" && echo "NDK: OK ($(du -sh "${ANDROID_SDK_ROOT}/ndk/28.2.13676358" | cut -f1))" || (echo "NDK: MISSING" && exit 1)
          test -d "${ANDROID_SDK_ROOT}/build-tools/37.0.0" && echo "Build-Tools 37.0.0: OK" || (echo "Build-Tools 37.0.0: MISSING" && exit 1)
          test -d "${ANDROID_SDK_ROOT}/platforms/android-37.0" && echo "Platform 37.0: OK" || (echo "Platform 37.0: MISSING" && exit 1)

      - name: "Phase 3 prasyarat — Smoke-test toolchain NDK cross-compile murni (arm64-v8a & armeabi-v7a)"
        run: |
          NDK="${ANDROID_SDK_ROOT}/ndk/28.2.13676358"
          TOOLCHAIN="$NDK/toolchains/llvm/prebuilt/linux-x86_64"
          API=26
          mkdir -p /tmp/ndk-smoke
          cat > /tmp/ndk-smoke/hello.c << 'CEOF'
          int main(void) { return 0; }
          CEOF

          echo "== Verifikasi binary toolchain ada dan executable =="
          test -x "$TOOLCHAIN/bin/clang" && echo "clang: OK" || (echo "clang: MISSING" && exit 1)
          test -x "$TOOLCHAIN/bin/llvm-ar" && echo "llvm-ar: OK" || (echo "llvm-ar: MISSING" && exit 1)
          test -x "$TOOLCHAIN/bin/llvm-ranlib" && echo "llvm-ranlib: OK" || (echo "llvm-ranlib: MISSING" && exit 1)
          test -x "$TOOLCHAIN/bin/llvm-strip" && echo "llvm-strip: OK" || (echo "llvm-strip: MISSING" && exit 1)

          echo "== Compile arm64-v8a (target aarch64-linux-android$API) =="
          "$TOOLCHAIN/bin/clang" --target=aarch64-linux-android$API -c /tmp/ndk-smoke/hello.c -o /tmp/ndk-smoke/hello-arm64.o
          file /tmp/ndk-smoke/hello-arm64.o

          echo "== Compile armeabi-v7a (target armv7a-linux-androideabi$API) =="
          "$TOOLCHAIN/bin/clang" --target=armv7a-linux-androideabi$API -c /tmp/ndk-smoke/hello.c -o /tmp/ndk-smoke/hello-armv7.o
          file /tmp/ndk-smoke/hello-armv7.o

          echo "== Pastikan BUKAN diam-diam ke-compile jadi x86_64 host (kegagalan paling umum) =="
          file /tmp/ndk-smoke/hello-arm64.o | grep -q "x86-64" && (echo "GAGAL: hello-arm64.o malah x86-64!" && exit 1) || echo "arm64.o bukan x86-64: OK"
          file /tmp/ndk-smoke/hello-armv7.o | grep -q "x86-64" && (echo "GAGAL: hello-armv7.o malah x86-64!" && exit 1) || echo "armv7.o bukan x86-64: OK"

          echo "== Pastikan arch benar-benar ARM =="
          file /tmp/ndk-smoke/hello-arm64.o | grep -q "aarch64" && echo "arm64.o arch aarch64: OK" || (echo "GAGAL: arm64.o bukan arch aarch64" && exit 1)
          file /tmp/ndk-smoke/hello-armv7.o | grep -qi "ARM" && echo "armv7.o arch ARM32: OK" || (echo "GAGAL: armv7.o bukan arch ARM32" && exit 1)

      - name: "Phase 3 — Cross-compile libtalloc.a (dependency proot) untuk arm64-v8a & armeabi-v7a"
        run: |
          set -e
          NDK="${ANDROID_SDK_ROOT}/ndk/28.2.13676358"
          TOOLCHAIN="$NDK/toolchains/llvm/prebuilt/linux-x86_64"
          API=26
          TALLOC_VERSION=2.4.3
          TALLOC_URL="https://www.samba.org/ftp/talloc/talloc-${TALLOC_VERSION}.tar.gz"
          TALLOC_SHA256="dc46c40b9f46bb34dd97fe41f548b0e8b247b77a918576733c528e83abd854dd"
          mkdir -p /tmp/libtalloc-build
          cd /tmp/libtalloc-build
          curl -fsSL "$TALLOC_URL" -o talloc.tar.gz
          echo "$TALLOC_SHA256  talloc.tar.gz" | sha256sum -c -
          build_one_abi() {
          ABI_NAME="$1"
          TARGET="$2"
          rm -rf "src-$ABI_NAME"
          mkdir -p "src-$ABI_NAME"
          tar -xzf talloc.tar.gz -C "src-$ABI_NAME" --strip-components=1
          cd "src-$ABI_NAME"
          export CC="$TOOLCHAIN/bin/clang --target=$TARGET$API"
          export AR="$TOOLCHAIN/bin/llvm-ar"
          export RANLIB="$TOOLCHAIN/bin/llvm-ranlib"
          export STRIP="$TOOLCHAIN/bin/llvm-strip"
          export LD="$TOOLCHAIN/bin/ld"
          echo "== [$ABI_NAME] cross-answers.txt =="
          cat > cross-answers.txt << CROSSEOF
          Checking uname sysname type: "Linux"
          Checking uname machine type: "dontcare"
          Checking uname release type: "dontcare"
          Checking uname version type: "dontcare"
          Checking simple C program: OK
          building library support: OK
          Checking for large file support: OK
          Checking for -D_FILE_OFFSET_BITS=64: OK
          Checking for WORDS_BIGENDIAN: OK
          Checking for C99 vsnprintf: OK
          Checking for HAVE_SECURE_MKSTEMP: OK
          rpath library support: OK
          -Wl,--version-script support: FAIL
          Checking correct behavior of strtoll: OK
          Checking correct behavior of strptime: OK
          Checking for HAVE_IFACE_GETIFADDRS: OK
          Checking for HAVE_IFACE_IFCONF: OK
          Checking for HAVE_IFACE_IFREQ: OK
          Checking getconf LFS_CFLAGS: OK
          Checking for large file support without additional flags: OK
          Checking for working strptime: OK
          Checking for HAVE_SHARED_MMAP: OK
          Checking for HAVE_MREMAP: OK
          Checking for HAVE_INCOHERENT_MMAP: OK
          Checking getconf large file support flags work: OK
          CROSSEOF
          echo "== [$ABI_NAME] configure =="
          ./configure --prefix=/tmp/libtalloc-install-$ABI_NAME --disable-rpath --disable-python --cross-compile --cross-answers=cross-answers.txt
          echo "== [$ABI_NAME] make =="
          make V=1
          echo "== [$ABI_NAME] verifikasi objek .o =="
          ls -la bin/default/talloc*.o
          cd bin/default
          "$AR" rcu libtalloc.a talloc*.o
          mkdir -p /tmp/libtalloc-out/$ABI_NAME
          cp libtalloc.a /tmp/libtalloc-out/$ABI_NAME/libtalloc.a
          cd /tmp/libtalloc-build
          echo "== [$ABI_NAME] hasil akhir =="
          file /tmp/libtalloc-out/$ABI_NAME/libtalloc.a
          }
          build_one_abi "arm64-v8a" "aarch64-linux-android"
          build_one_abi "armeabi-v7a" "armv7a-linux-androideabi"

      - name: "VERIFY libtalloc.a nyata untuk kedua ABI (ekstrak objek, cek arch ELF sebenarnya)"
        run: |
          set -e
          test -f /tmp/libtalloc-out/arm64-v8a/libtalloc.a && echo "arm64-v8a: ada" || (echo "MISSING arm64-v8a" && exit 1)
          test -f /tmp/libtalloc-out/armeabi-v7a/libtalloc.a && echo "armeabi-v7a: ada" || (echo "MISSING armeabi-v7a" && exit 1)
          verify_abi() {
          ABI_NAME="$1"
          EXPECT_ARCH="$2"
          mkdir -p /tmp/libtalloc-verify-$ABI_NAME
          cd /tmp/libtalloc-verify-$ABI_NAME
          "${ANDROID_SDK_ROOT}/ndk/28.2.13676358/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ar" x /tmp/libtalloc-out/$ABI_NAME/libtalloc.a
          echo "== [$ABI_NAME] daftar objek hasil ekstrak =="
          ls -la
          test -n "$(ls *.o 2>/dev/null)" || (echo "GAGAL [$ABI_NAME]: tidak ada file .o di dalam archive" && exit 1)
          for OBJFILE in *.o; do
          echo "-- $OBJFILE --"
          file "$OBJFILE"
          file "$OBJFILE" | grep -qi "x86-64" && (echo "GAGAL [$ABI_NAME] $OBJFILE malah x86-64" && exit 1) || true
          file "$OBJFILE" | grep -qi "$EXPECT_ARCH" || (echo "GAGAL [$ABI_NAME] $OBJFILE bukan arch $EXPECT_ARCH" && exit 1)
          done
          echo "== [$ABI_NAME] semua objek terverifikasi arch $EXPECT_ARCH =="
          }
          verify_abi "arm64-v8a" "aarch64"
          verify_abi "armeabi-v7a" "ARM"

      - name: Upload libtalloc.a artifacts (Phase 3, dependency proot)
        uses: actions/upload-artifact@v4
        with:
          name: Molina-X-libtalloc
          path: |
            /tmp/libtalloc-out/arm64-v8a/libtalloc.a
            /tmp/libtalloc-out/armeabi-v7a/libtalloc.a
          if-no-files-found: error

      - name: "Phase 3 — Cross-compile proot (link static ke libtalloc.a) untuk arm64-v8a & armeabi-v7a"
        run: |
          set -e
          NDK="${ANDROID_SDK_ROOT}/ndk/28.2.13676358"
          TOOLCHAIN="$NDK/toolchains/llvm/prebuilt/linux-x86_64"
          API=26
          PROOT_COMMIT=1f4ec1c9d3fcc5d44c2a252eda6d09b0c24928cd
          PROOT_URL="https://github.com/termux/proot/archive/${PROOT_COMMIT}.zip"
          PROOT_SHA256="1119f1d27ca7a655eb627ad227fbd9c7a0343ea988dad3ed620fd6cd98723c20"
          mkdir -p /tmp/proot-build
          cd /tmp/proot-build
          curl -fsSL "$PROOT_URL" -o proot.zip
          echo "$PROOT_SHA256  proot.zip" | sha256sum -c -
          build_proot_one_abi() {
          ABI_NAME="$1"
          TARGET="$2"
          rm -rf "src-$ABI_NAME" pc-$ABI_NAME
          mkdir -p "src-$ABI_NAME" "pc-$ABI_NAME"
          unzip -q proot.zip -d "extract-$ABI_NAME"
          SRCDIR=$(find "extract-$ABI_NAME" -maxdepth 1 -mindepth 1 -type d | head -1)
          cp -r "$SRCDIR"/. "src-$ABI_NAME"/
          TALLOC_INCLUDE="/tmp/libtalloc-build/src-$ABI_NAME"
          TALLOC_LIBDIR="/tmp/libtalloc-out/$ABI_NAME"
          test -f "$TALLOC_INCLUDE/talloc.h" || (echo "GAGAL [$ABI_NAME]: talloc.h tidak ditemukan di $TALLOC_INCLUDE" && exit 1)
          test -f "$TALLOC_LIBDIR/libtalloc.a" || (echo "GAGAL [$ABI_NAME]: libtalloc.a tidak ditemukan di $TALLOC_LIBDIR" && exit 1)
          printf "prefix=%s\nexec_prefix=%s\nlibdir=%s\nincludedir=%s\n\nName: talloc\nDescription: talloc\nVersion: 2.4.3\nLibs: -L%s -ltalloc\nCflags: -I%s\n" "$TALLOC_LIBDIR" "$TALLOC_LIBDIR" "$TALLOC_LIBDIR" "$TALLOC_INCLUDE" "$TALLOC_LIBDIR" "$TALLOC_INCLUDE" > "pc-$ABI_NAME/talloc.pc"
          echo "== [$ABI_NAME] isi talloc.pc =="
          cat "pc-$ABI_NAME/talloc.pc"
          export PKG_CONFIG_PATH="/tmp/proot-build/pc-$ABI_NAME"
          echo "== [$ABI_NAME] verifikasi pkg-config menemukan talloc =="
          pkg-config --cflags talloc
          pkg-config --libs talloc
          cd "src-$ABI_NAME"
          echo "== [$ABI_NAME] patch P_tmpdir (persis recipe resmi) =="
          sed -i "s/P_tmpdir/\"\/tmp\"/g" src/path/temp.c
          grep -n "P_tmpdir\|/tmp" src/path/temp.c | head -5
          export CC="$TOOLCHAIN/bin/clang --target=$TARGET$API"
          export AR="$TOOLCHAIN/bin/llvm-ar"
          export RANLIB="$TOOLCHAIN/bin/llvm-ranlib"
          export STRIP="$TOOLCHAIN/bin/llvm-strip"
          export OBJCOPY="$TOOLCHAIN/bin/llvm-objcopy"
          export OBJDUMP="$TOOLCHAIN/bin/llvm-objdump"
          export CPPFLAGS="-DARG_MAX=131072 -I$TALLOC_INCLUDE"
          export LDFLAGS="-static -L$TALLOC_LIBDIR -ltalloc"
          echo "== [$ABI_NAME] make V=1 =="
          cd src
          make V=1
          test -f proot || (echo "GAGAL [$ABI_NAME]: binary proot tidak dihasilkan" && exit 1)
          "$STRIP" proot
          mkdir -p /tmp/proot-out/$ABI_NAME
          cp proot /tmp/proot-out/$ABI_NAME/proot
          cd /tmp/proot-build
          echo "== [$ABI_NAME] hasil akhir =="
          file /tmp/proot-out/$ABI_NAME/proot
          }
          build_proot_one_abi "arm64-v8a" "aarch64-linux-android"
          build_proot_one_abi "armeabi-v7a" "armv7a-linux-androideabi"

      - name: "VERIFY binary proot nyata untuk kedua ABI (ELF ARM, statis, bukan x86_64)"
        run: |
          set -e
          for ABI in arm64-v8a armeabi-v7a; do
          BIN="/tmp/proot-out/$ABI/proot"
          test -f "$BIN" || (echo "MISSING $ABI" && exit 1)
          echo "-- $ABI --"
          file "$BIN"
          file "$BIN" | grep -qi "x86-64" && (echo "GAGAL [$ABI]: proot malah x86-64" && exit 1) || echo "$ABI bukan x86-64: OK"
          file "$BIN" | grep -qi "statically linked" || (echo "GAGAL [$ABI]: proot bukan statically linked" && exit 1)
          echo "$ABI statically linked: OK"
          done
          file /tmp/proot-out/arm64-v8a/proot | grep -qi "aarch64" || (echo "GAGAL: arm64-v8a bukan aarch64" && exit 1)
          file /tmp/proot-out/armeabi-v7a/proot | grep -qi "ARM" || (echo "GAGAL: armeabi-v7a bukan ARM" && exit 1)
          echo "Semua verifikasi proot lolos."

      - name: Upload proot binary artifacts (Phase 3)
        uses: actions/upload-artifact@v4
        with:
          name: Molina-X-proot
          path: |
            /tmp/proot-out/arm64-v8a/proot
            /tmp/proot-out/armeabi-v7a/proot
          if-no-files-found: error

      - name: "Phase 3 — Salin binary proot ke feature-terminal jniLibs (Opsi A: bundling via jniLibs)"
        run: |
          set -e
          mkdir -p feature-terminal/src/main/jniLibs/arm64-v8a
          mkdir -p feature-terminal/src/main/jniLibs/armeabi-v7a
          cp /tmp/proot-out/arm64-v8a/proot feature-terminal/src/main/jniLibs/arm64-v8a/libproot.so
          cp /tmp/proot-out/armeabi-v7a/proot feature-terminal/src/main/jniLibs/armeabi-v7a/libproot.so
          chmod 755 feature-terminal/src/main/jniLibs/arm64-v8a/libproot.so
          chmod 755 feature-terminal/src/main/jniLibs/armeabi-v7a/libproot.so
          echo "== isi jniLibs feature-terminal =="
          find feature-terminal/src/main/jniLibs -type f -exec ls -la {} \;

      - name: Make gradlew executable
        run: chmod +x ./gradlew

      - name: Build debug APK (App Host, Phase 1)
        run: ./gradlew :app:assembleDebug --stacktrace

      - name: VERIFY APK actually exists on disk
        run: |
          APK_PATH="app/build/outputs/apk/debug/app-debug.apk"
          test -f "$APK_PATH" && echo "APK: OK ($(du -sh "$APK_PATH" | cut -f1))" || (echo "APK: MISSING at $APK_PATH" && find app/build/outputs -type f && exit 1)

      - name: Upload debug APK artifact
        uses: actions/upload-artifact@v4
        with:
          name: Molina-X-debug-apk
          path: app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error

      - name: Build terminal-emulator + terminal-view (Phase 2, termasuk native libtermux.so via NDK)
        run: ./gradlew :feature-terminal:terminal-emulator:assembleDebug :feature-terminal:terminal-view:assembleDebug --stacktrace

      - name: VERIFY AAR terminal-emulator & terminal-view actually exist on disk
        run: |
          EMULATOR_AAR="feature-terminal/terminal-emulator/build/outputs/aar/terminal-emulator-debug.aar"
          VIEW_AAR="feature-terminal/terminal-view/build/outputs/aar/terminal-view-debug.aar"
          test -f "$EMULATOR_AAR" && echo "terminal-emulator AAR: OK ($(du -sh "$EMULATOR_AAR" | cut -f1))" || (echo "terminal-emulator AAR: MISSING" && find feature-terminal/terminal-emulator/build/outputs -type f && exit 1)
          test -f "$VIEW_AAR" && echo "terminal-view AAR: OK ($(du -sh "$VIEW_AAR" | cut -f1))" || (echo "terminal-view AAR: MISSING" && find feature-terminal/terminal-view/build/outputs -type f && exit 1)

      - name: VERIFY libtermux.so nyata ter-compile untuk kedua ABI (arm64-v8a, armeabi-v7a)
        run: |
          mkdir -p /tmp/aar-check
          unzip -o feature-terminal/terminal-emulator/build/outputs/aar/terminal-emulator-debug.aar -d /tmp/aar-check
          echo "== Isi folder jni/ di dalam AAR =="
          find /tmp/aar-check/jni -type f
          test -f /tmp/aar-check/jni/arm64-v8a/libtermux.so && echo "libtermux.so arm64-v8a: OK" || (echo "libtermux.so arm64-v8a: MISSING" && exit 1)
          test -f /tmp/aar-check/jni/armeabi-v7a/libtermux.so && echo "libtermux.so armeabi-v7a: OK" || (echo "libtermux.so armeabi-v7a: MISSING" && exit 1)

      - name: Upload AAR artifacts (terminal-emulator, terminal-view)
        uses: actions/upload-artifact@v4
        with:
          name: Molina-X-terminal-aar
          path: |
            feature-terminal/terminal-emulator/build/outputs/aar/terminal-emulator-debug.aar
            feature-terminal/terminal-view/build/outputs/aar/terminal-view-debug.aar
          if-no-files-found: error

      - name: "Phase 3 — Build feature-terminal (verifikasi settings.gradle.kts + jniLibs proot)"
        run: ./gradlew :feature-terminal:assembleDebug --stacktrace

      - name: VERIFY AAR feature-terminal actually exists on disk
        run: |
          FEATURE_TERMINAL_AAR="feature-terminal/build/outputs/aar/feature-terminal-debug.aar"
          test -f "$FEATURE_TERMINAL_AAR" && echo "feature-terminal AAR: OK ($(du -sh "$FEATURE_TERMINAL_AAR" | cut -f1))" || (echo "feature-terminal AAR: MISSING" && find feature-terminal/build/outputs -type f && exit 1)

      - name: "VERIFY libproot.so nyata ter-bundle di AAR feature-terminal untuk kedua ABI"
        run: |
          mkdir -p /tmp/aar-check-proot
          unzip -o feature-terminal/build/outputs/aar/feature-terminal-debug.aar -d /tmp/aar-check-proot
          echo "== Isi folder jni/ di dalam AAR feature-terminal =="
          find /tmp/aar-check-proot/jni -type f
          test -f /tmp/aar-check-proot/jni/arm64-v8a/libproot.so && echo "libproot.so arm64-v8a: OK" || (echo "libproot.so arm64-v8a: MISSING" && exit 1)
          test -f /tmp/aar-check-proot/jni/armeabi-v7a/libproot.so && echo "libproot.so armeabi-v7a: OK" || (echo "libproot.so armeabi-v7a: MISSING" && exit 1)
          echo "== VERIFY arch nyata libproot.so (bukan cuma nama file) =="
          file /tmp/aar-check-proot/jni/arm64-v8a/libproot.so
          file /tmp/aar-check-proot/jni/arm64-v8a/libproot.so | grep -qi "aarch64" || (echo "GAGAL: libproot.so arm64-v8a bukan aarch64" && exit 1)
          file /tmp/aar-check-proot/jni/armeabi-v7a/libproot.so
          file /tmp/aar-check-proot/jni/armeabi-v7a/libproot.so | grep -qi "ARM" || (echo "GAGAL: libproot.so armeabi-v7a bukan ARM" && exit 1)
          echo "Semua verifikasi libproot.so di AAR feature-terminal lolos."

      - name: Upload AAR artifact (feature-terminal)
        uses: actions/upload-artifact@v4
        with:
          name: Molina-X-feature-terminal-aar
          path: feature-terminal/build/outputs/aar/feature-terminal-debug.aar
          if-no-files-found: error

      - name: "Phase 3 — Build feature-terminal:runtime (modul rootfs manifest, blueprint §8.4)"
        run: ./gradlew :feature-terminal:runtime:assembleDebug --stacktrace

      - name: VERIFY AAR feature-terminal:runtime actually exists on disk
        run: |
          RUNTIME_AAR="feature-terminal/runtime/build/outputs/aar/runtime-debug.aar"
          test -f "$RUNTIME_AAR" && echo "feature-terminal:runtime AAR: OK ($(du -sh "$RUNTIME_AAR" | cut -f1))" || (echo "feature-terminal:runtime AAR: MISSING" && find feature-terminal/runtime/build/outputs -type f && exit 1)

      - name: "Phase 3 — Jalankan unit test feature-terminal:runtime (manifest, checksum, path validator, tar extractor)"
        run: ./gradlew :feature-terminal:runtime:testDebugUnitTest --stacktrace

      - name: VERIFY hasil unit test feature-terminal:runtime nyata (0 failures, bukan cuma exit code gradle)
        run: |
          RESULT_XML=$(find feature-terminal/runtime/build/test-results/testDebugUnitTest -name "TEST-*.xml")
          test -n "$RESULT_XML" || (echo "GAGAL: tidak ada file hasil test XML ditemukan" && exit 1)
          echo "== File hasil test ditemukan =="
          echo "$RESULT_XML"
          for f in $RESULT_XML; do
            echo "-- $f --"
            cat "$f"
            grep -o 'failures="[0-9]*"' "$f" | grep -q 'failures="0"' || (echo "GAGAL: ada test failure di $f" && exit 1)
            grep -o 'errors="[0-9]*"' "$f" | grep -q 'errors="0"' || (echo "GAGAL: ada test error di $f" && exit 1)
          done
          echo "Semua unit test RootfsManifest lolos (0 failures, 0 errors)."

      - name: Upload AAR artifact (feature-terminal:runtime)
        uses: actions/upload-artifact@v4
        with:
          name: Molina-X-feature-terminal-runtime-aar
          path: feature-terminal/runtime/build/outputs/aar/runtime-debug.aar
          if-no-files-found: error

      - name: "Phase 3 — Integration test JARINGAN NYATA: download+verify+extract rootfs Debian asli (kedua ABI)"
        env:
          MOLINAX_RUN_NETWORK_TESTS: "true"
        run: ./gradlew :feature-terminal:runtime:testDebugUnitTest --tests "*RootfsIntegrationTest*" --stacktrace

      - name: "VERIFY integration test rootfs asli benar-benar berjalan (bukan silently skipped) dan lolos"
        run: |
          RESULT_XML=$(find feature-terminal/runtime/build/test-results/testDebugUnitTest -name "TEST-*RootfsIntegrationTest*.xml")
          test -n "$RESULT_XML" || (echo "GAGAL: tidak ada file hasil test RootfsIntegrationTest ditemukan" && exit 1)
          echo "== File hasil test =="
          echo "$RESULT_XML"
          cat "$RESULT_XML"
          grep -o 'tests="[0-9]*"' "$RESULT_XML" | grep -q 'tests="2"' || (echo "GAGAL: jumlah test bukan 2" && exit 1)
          grep -o 'skipped="[0-9]*"' "$RESULT_XML" | grep -q 'skipped="0"' || (echo "GAGAL: ada test yang di-skip -- kemungkinan MOLINAX_RUN_NETWORK_TESTS tidak terbaca benar" && exit 1)
          grep -o 'failures="[0-9]*"' "$RESULT_XML" | grep -q 'failures="0"' || (echo "GAGAL: ada test failure -- struktur rootfs asli tidak sesuai ekspektasi" && exit 1)
          grep -o 'errors="[0-9]*"' "$RESULT_XML" | grep -q 'errors="0"' || (echo "GAGAL: ada test error" && exit 1)
          echo "Integration test rootfs asli lolos nyata: 2 test dijalankan (bukan di-skip), 0 failures, 0 errors."
